" ioi-env — vim 設定（賽場等級，刻意不裝插件）
" 比賽機器上沒有插件，依賴插件的習慣會在賽場失效。
" 按鍵都指向真实存在的檔案；沒有的輸入檔就開新的給你，不會 silent fail。

set nocompatible
syntax on
filetype plugin indent on

set number
set ruler
set showmatch
set nowrap
set incsearch hlsearch
set ignorecase smartcase
set backspace=indent,eol,start

" 4 空格縮排
set tabstop=4 shiftwidth=4 softtabstop=4 expandtab
set autoindent smartindent

let mapleader = ' '

" ─── 編譯執行 ───────────────────────────────────────
" F5：存檔 + 編譯 + 執行（stdin）
nnoremap <F5> :w<CR>:!g++ -O2 -std=c++17 -Wall -Wextra -o /tmp/a % && /tmp/a<CR>

" F6：存檔 + 只編譯不執行
nnoremap <F6> :w<CR>:!g++ -O2 -std=c++17 -Wall -Wextra -fsyntax-only %<CR>

" F7：ASan/UBSan 編譯 + 執行（對拍找 bug 用）
nnoremap <F7> :w<CR>:!g++ -g -O1 -std=c++17 -fsanitize=address,undefined -o /tmp/a_dbg % && setarch $(uname -m) -R /tmp/a_dbg<CR>

" F8：量時間與記憶體
nnoremap <F8> :w<CR>:!g++ -O2 -std=c++17 -o /tmp/a % && /usr/bin/time -v /tmp/a<CR>

" ─── 除錯 ───────────────────────────────────────────
" <Leader>d：gdb 開剛編好的 binary
nnoremap <Leader>d :!g++ -g -O0 -std=c++17 -o /tmp/a_gdb % && gdb /tmp/a_gdb<CR>

" ─── 常用 ───────────────────────────────────────────
" <Leader>w 存檔；jj 離開 insert
nnoremap <Leader>w :w<CR>
inoremap jj <Esc>

" 輸入檔不存在時，<Leader>i 幫你開一個（而不是讓 F5 之後的指令悄悄失敗）
nnoremap <Leader>i :e input.txt<CR>
